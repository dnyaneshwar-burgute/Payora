<% content_for :title, @organization.name %>

<div class="container py-4">
  <div class="col-lg-8 mx-auto">
    <%= link_to "← All organizations", admin_organizations_path, class: "small text-decoration-none" %>

    <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
      <h1 class="h4 mb-0"><%= @organization.name %></h1>
      <%= organization_status_badge(@organization) %>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Host</dt>
          <dd class="col-sm-8"><%= @organization.host %></dd>

          <dt class="col-sm-4">Registered</dt>
          <dd class="col-sm-8"><%= l @organization.created_at, format: :long %></dd>

          <dt class="col-sm-4">Owner</dt>
          <dd class="col-sm-8">
            <% @organization.owners.each do |owner| %>
              <div><%= owner.full_name %> &lt;<%= owner.email_address %>&gt;</div>
            <% end %>
          </dd>

          <% if @organization.rejected? %>
            <dt class="col-sm-4">Rejection reason</dt>
            <dd class="col-sm-8"><%= simple_format @organization.rejection_reason, class: "mb-0" %></dd>
          <% end %>
        </dl>
      </div>
    </div>

    <% if @organization.created? %>
      <div class="row g-3">
        <div class="col-md-5">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h2 class="h6">Approve</h2>
              <p class="small text-muted">The owner will receive an invitation email to set their password.</p>
              <%= button_to "Approve organization", change_state_admin_organization_path(@organization), method: :patch, params: { event: "approve" }, class: "btn btn-success w-100" %>
            </div>
          </div>
        </div>

        <div class="col-md-7">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h2 class="h6">Reject</h2>
              <%= form_with url: change_state_admin_organization_path(@organization), method: :patch do |form| %>
                <%= form.hidden_field :event, value: "reject" %>
                <div class="mb-3">
                  <%= form.label :rejection_reason, "Reason", class: "form-label small" %>
                  <%= form.text_area :rejection_reason, value: @organization.rejection_reason, rows: 3, required: true, class: field_class(@organization, :rejection_reason) %>
                  <%= field_errors(@organization, :rejection_reason) %>
                </div>
                <%= form.submit "Reject organization", class: "btn btn-outline-danger w-100" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
