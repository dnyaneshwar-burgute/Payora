<% content_for :title, "Accept invitation" %>
<% user = @invitation.user %>

<h2 class="h5 mb-1">Welcome, <%= user.first_name %></h2>
<p class="text-muted small mb-4">
  Set a password to join <strong><%= user.organization.name %></strong> as <%= @invitation.role.name %>.
</p>

<%= form_with url: invitation_path(params[:token]), method: :patch do |form| %>
  <div class="mb-3">
    <%= form.label :email_address, class: "form-label" %>
    <%= form.email_field :email_address, value: user.email_address, disabled: true, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :password, class: "form-label" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: field_class(user, :password) %>
    <%= field_errors(user, :password) %>
  </div>

  <div class="mb-3">
    <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_class(user, :password_confirmation) %>
    <%= field_errors(user, :password_confirmation) %>
  </div>

  <%= form.submit "Set password", class: "btn btn-primary w-100" %>
<% end %>
