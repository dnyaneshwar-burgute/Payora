<% content_for :title, "#{@organization.name} dashboard" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h4 mb-0"><%= @organization.name %></h1>
      <div class="text-muted small"><%= @organization.host %></div>
    </div>
    <%= organization_status_badge(@organization) %>
  </div>

  <p class="text-muted">Welcome back, <%= Current.user.first_name %>.</p>

  <% if Current.user.organization_owner? %>
    <div class="row g-3">
      <% { "Users" => @users_count, "Departments" => @departments_count }.each do |label, count| %>
        <div class="col-md-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small"><%= label %></div>
              <div class="h3 mb-0"><%= count %></div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="text-muted small">Users by role</div>
            <p class="small text-muted mt-2 mb-3">How many people currently hold each role.</p>
            <%= link_to "View report", tenant_dashboard_roles_path, class: "btn btn-outline-primary btn-sm mt-auto align-self-start" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
