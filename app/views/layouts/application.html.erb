<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "application.tsx" %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <nav class="navbar navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Salary Management", root_path, class: "navbar-brand" %>

        <div class="d-flex align-items-center gap-2">
          <% if authenticated? %>
            <% if Current.user.platform_admin? %>
              <%= link_to "Organizations", admin_organizations_path, class: "btn btn-link btn-sm text-light text-decoration-none" %>
            <% end %>
            <span class="navbar-text me-2"><%= Current.user.full_name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "btn btn-outline-light btn-sm" %>
            <%= link_to "Register organization", new_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container pt-3">
      <%= render "layouts/flash" %>
    </div>

    <%= yield %>
  </body>
</html>
