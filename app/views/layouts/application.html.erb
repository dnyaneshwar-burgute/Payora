<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "application.tsx" %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body class="bg-light">
    <% if authenticated? %>
      <div class="d-flex min-vh-100">
        <aside class="app-sidebar bg-dark text-light d-flex flex-column flex-shrink-0 p-3">
          <%= link_to Current.organization&.name || "Salary Management", root_path, class: "text-light text-decoration-none fw-semibold" %>
          <% if Current.organization %>
              <%= link_to "Dashboard", tenant_dashboard_path, class: "btn btn-link btn-sm text-light text-decoration-none text-start px-0" %>
          <% end %>
          <div class="mt-auto d-flex flex-column gap-2">
            <div class="small text-white-50"><%= Current.user.full_name %></div>
            <% if Current.user.platform_admin? %>
              <%= link_to "Organizations", admin_organizations_path, class: "btn btn-link btn-sm text-light text-decoration-none text-start px-0" %>
            <% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-outline-light btn-sm", form_class: "m-0" %>
          </div>
        </aside>

        <div class="flex-grow-1">
          <div class="container pt-3">
            <%= render "layouts/flash" %>
          </div>

          <%= yield %>
        </div>
      </div>
    <% else %>
      <nav class="navbar navbar-dark bg-dark">
        <div class="container">
          <%= link_to Current.organization&.name || "Salary Management", root_path, class: "navbar-brand" %>

          <div class="d-flex align-items-center gap-2">
            <%= link_to "Sign in", new_session_path, class: "btn btn-outline-light btn-sm" %>
            <% unless Current.organization %>
              <%= link_to "Register organization", new_registration_path, class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </div>
      </nav>

      <div class="container pt-3">
        <%= render "layouts/flash" %>
      </div>

      <%= yield %>
    <% end %>
  </body>
</html>
